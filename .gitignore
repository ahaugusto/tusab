# ============================================================
# SEBAYT — .gitignore
# ============================================================

# --- Credenciais e tokens OAuth (NUNCA subir) ---
credentials.json
data/config/
*.json.bak
.env
.env.*

# --- Dados gerados em runtime ---
data/neural/
data/indexes/
release_notes.md
data/cerebro/
data/cerebro_txt/
data/gestao/
data/agent_index/
data/temp/

# --- Legado (caminhos antigos) ---
cerebro_txt/
gestao_local/
brainiac_txt/
brainiac_mgmt/

# --- Backup local (não vai pro git, mas mantém no disco) ---
_backup_local/
backup/

# --- Build / Distribuição (PyInstaller) ---
build/
dist/
output/

# --- Pacotes e binários ---
*.zip
*.exe

# --- Node / Frontend ---
web_interface/node_modules/
web_interface/.vite/

# --- Ferramentas de análise de código (cache local, não versionar) ---
graphify-out/

# --- Electron ---
electron/node_modules/
electron/python_env/
electron/bin/
electron/build_resources/*.bmp
electron/build_resources/*.ico
dist_electron/

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.pyo
.Python

# --- Ambientes virtuais ---
.venv
venv/
env/
ENV/

# --- IDEs ---
.vscode/
.idea/
*.suo
*.user

# --- Claude Code (settings locais, não o skill) ---
.claude/settings.local.json
.claude/worktrees/

# --- Documentação de produto: movida pra repo privado separado
# (ahaugusto/tusab-docs) em 2026-08-07, junto com limpeza retroativa do
# histórico deste repo (git filter-repo --invert-paths) — estratégia de
# negócio/roadmap/B2B não pode ficar exposta quando este repo virar público.
# Continua presente localmente (fora do git), só não é mais rastreada aqui.
Documentação do Produto/

# --- Logs de crash (podem conter informações sensíveis) ---
sebayt_crash.log
*.log

# --- OS ---
.DS_Store
Thumbs.db

# --- Segredos de assinatura/notarização Apple (nunca versionar) ---
Apple/
*.p12
*.p8
*.cer
# Auditoria de segurança — venv isolado do gerador de PDF (recriar via python -m venv)
docs/security-audit/.venv-report/
docs/security-audit/__pycache__/
